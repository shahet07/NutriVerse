{
  "manifest_version": 3,
  "name": "NutriVerse",
  "version": "2.1.0",
  "description": "Indian food nutrition intelligence. Look up any dish, classify food images, and get detailed nutrition breakdowns.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup/popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "options_page": "options/options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "storage", "scripting", "identity"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://localhost:8000/*",
        "https://nutrisense-ai-c8f2anche0b6a8be.southeastasia-01.azurewebsites.net/*"
      ],
      "js": ["content.js"]
    }
  ]
}
