# Copy to .env. scripts/run-local.sh creates a working local .env for you.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
AUTH_SECRET_KEY=

# Empty GROQ_API_KEY: uses the local Ollama model below.
GROQ_API_KEY=
OLLAMA_MODEL=llama3.2

# Needed unless Git LFS has pulled the real checkpoint.
MODEL_PATH=

# Local development only. Never enable on a server.
AUTH_DEV_LOGIN=true

# Firebase. Leave empty for local sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
